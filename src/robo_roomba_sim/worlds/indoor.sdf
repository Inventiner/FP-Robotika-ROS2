    </model>

    <model name='virtual_wall'>
      <static>true</static>
      <pose> -3.3 -10.95 1.69 0 0 0</pose>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <box><size>2.0 0.1 2.0</size></box>
          </geometry>
        </collision>
        <visual name='visual'>
           <transparency>0.8</transparency>
           <geometry>
             <box><size>2.0 0.1 2.0</size></box>
           </geometry>
           <material>
             <ambient>0 0 1 0.2</ambient>
             <diffuse>0 0 1 0.2</diffuse>
           </material>
        </visual>
      </link>
    </model>

