<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="cafe_on_null_island">
    
    <!-- 1. PLUGINS -->
    <plugin filename="libignition-gazebo-physics-system.so" name="ignition::gazebo::systems::Physics">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </plugin>
    <plugin filename="libignition-gazebo-sensors-system.so" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="libignition-gazebo-scene-broadcaster-system.so" name="ignition::gazebo::systems::SceneBroadcaster"></plugin>
    <plugin filename="libignition-gazebo-user-commands-system.so" name="ignition::gazebo::systems::UserCommands"></plugin>
    <plugin filename="libignition-gazebo-contact-system.so" name="ignition::gazebo::systems::Contact"></plugin>

    <!-- 2. SCENE -->
    <scene>
      <grid>false</grid>
      <ambient>0.8 0.8 0.8 1.0</ambient>
      <background>0.53 0.80 0.92 1.0</background>
      <shadows>true</shadows>
    </scene>

    <!-- 3. LIGHTING -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0.75 0</pose>
      <diffuse>1.0 0.65 0.2 1</diffuse> 
      <specular>0.1 0.1 0.1 1</specular>
      <intensity>4</intensity>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- 4. ENVIRONMENT -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Ground%20Plane</uri>
      <pose>0 0 -0.2 0 0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Null Island</uri>
    </include>
      
    <!-- Ocean -->
    <model name="ocean">
      <static>true</static>
      <pose>0 0 -0.1 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>200 200 0.1</size></box></geometry>
          <material>
            <ambient>0.0 0.1 0.6 1</ambient>
            <diffuse>0.0 0.1 0.6 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
        <collision name="collision">
          <geometry><box><size>200 200 0.1</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- 5. CAFE -->
    <model name="cafe">
      <static>true</static>
      <pose>0 0 0.5 0 0 0</pose> 
      <link name="link">
        
        <visual name="visual">
          <geometry>
            <mesh>
              <uri>model://cafe/meshes/cafe.dae</uri>
            </mesh>
          </geometry>
        </visual>

        <!-- COLLISIONS -->
        <collision name="main_floor">
          <pose>-0.4 -0.25 0.0948 0 0 0</pose>
          <geometry><box><size>9.38 25.0 0.19</size></box></geometry>
        </collision>
        <collision name="wall_1">
          <pose>-5.03 0.53 1.415 0 0 0</pose>
          <geometry><box><size>.12 23.16 2.83</size></box></geometry>
        </collision>
        <collision name="wall_2">
          <pose>4.24 -.31 1.415 0 0 0</pose>
          <geometry><box><size>.12 21.48 2.83</size></box></geometry>
        </collision>
        <collision name="wall_3_part_a"> <!-- Left side of the kitchen door -->
          <pose>-2.05 7.43 1.415 0 0 0</pose>
          <geometry><box><size>5.9 0.12 2.83</size></box></geometry>
        </collision>
        <collision name="wall_3_part_b"> <!-- Right side of the kitchen door -->
          <pose>2.09 7.43 1.415 0 0 0</pose>
          <geometry><box><size>0.1 0.12 2.83</size></box></geometry>
        </collision>
        <collision name="wall_4">
